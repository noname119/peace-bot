TG_API_ID=123456
TG_API_HASH=your_api_hash
SESSION_NAME=userbot

OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_THINKING=1
LLM_REASONING_EFFORT=high

REPLY_ENABLED=1
CHIME_ENABLED=1
CHIME_MIN_GAP=900
MANDATORY_REPLY=1
CONFLICT_MIN_GAP=90

# Самопроизвольные пробуждения по таймеру, минут (0 = выключено).
PROACTIVE_WAKE_MINUTES=60

# Распознавание картинок (пустые значения наследуются из OPENAI_* выше).
# deepseek-flash видит картинки из коробки; для других провайдеров
# укажите vision-совместимый endpoint, например OpenAI (gpt-4o-mini),
# OpenRouter или локальную модель (Ollama llava, LM Studio).
VISION_ENABLED=1
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
